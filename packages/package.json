{
  "name": "@two-web/kit",
  "version": "0.0.1-rc.5",
  "description": "A collection of packages to enhance your 2web application",
  "author": "hudson-newey",
  "main": "dist/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hudson-newey/2web.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite ./dev/",
    "build": "vite build",
    "test": "vitest",
    "format": "prettier --write",
    "lint": "oxlint"
  },
  "files": [
    "dist/",
    "vite-plugin/"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
