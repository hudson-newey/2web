      "types": "./dist/animations/index.d.ts"
    },
    "./iron": {
      "import": "./dist/iron.js",
      "types": "./dist/iron/index.d.ts"
    },
    "./named-strings": {
      "import": "./dist/named-strings.js",
      "types": "./dist/named-strings/index.d.ts"
    },
    "./pre-fetcher": {
      "import": "./dist/pre-fetcher.js",
      "types": "./dist/pre-fetcher/index.d.ts"
    },
    "./route-guards": {
      "import": "./dist/route-guards.js",
      "types": "./dist/route-guards/index.d.ts"
    },
    "./ssr": {
      "import": "./dist/ssr.js",
      "types": "./dist/ssr/index.d.ts"
    },
    "./typescript": {
      "import": "./dist/typescript.js",
      "types": "./dist/typescript/index.d.ts"
    },
    "./2js": {
      "import": "./dist/2js.js",
      "types": "./dist/2js/index.d.ts"
    },
    "./vite-plugin": {
      "import": "./vite-plugin/index.ts",
      "types": "./vite-plugin/index.d.ts"
    }
  },
  "dependencies": {
    "express": "^5.3.0",
    "happy-dom": "21.0.4",
    "sanitize-filename": "^1.6.5"
  },
  "devDependencies": {
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "express": "^5.1.0",
    "happy-dom": "17.4.7",
    "vite": "^6.3.4"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
