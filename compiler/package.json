{
  "name": "@two-web/compiler",
  "version": "0.0.1-rc.5",
  "description": "A compiler-based web framework",
  "keywords": [
    "frontend",
    "framework",
    "compiler"
  ],
  "author": "hudson-newey",
  "type": "module",
  "license": "MIT",
  "types": "types/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hudson-newey/2web.git"
  },
  "scripts": {
    "dev": "vite ./dist/",
    "format": "prettier --write ./dev/",
    "test": "vitest",
    "test:report": "vite preview --outDir html-report",
    "build": "task build"
  },
  "bin": {
    "2webc": "bin/2webc"
  },
  "files": [
    "bin/",
    "types/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./types/index.d.ts"
    }
  },
  "devDependencies": {
    "@ngneat/falso": "^8.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/ui": "5.1.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.92.0",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
